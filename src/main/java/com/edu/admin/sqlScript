create
    definer = spec@`%` function category_hierarchy_connect(value int) returns int
BEGIN
    DECLARE _category_id char(4);
    DECLARE _category_upper INT;
    DECLARE _next INT;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET @idx = NULL;

    SET _category_upper = @idx;
    SET _category_id = -1;

    IF @idx IS NULL THEN
        RETURN NULL;
    END IF;

    LOOP
        SELECT MIN(category_id)
        INTO @idx
        FROM category
        WHERE category_upper = _category_upper
          AND category_id > _category_id;

        IF @idx IS NOT NULL OR _category_upper = @start_with THEN
            SET @level = @level + 1;
            RETURN @idx;
        END IF;

        SET @level := @level - 1;
        SELECT category_id, category_upper
        INTO _category_id, _category_upper
        FROM category
        WHERE category_id = _category_upper;
    END LOOP;

END;

